APP_NAME="Carnelli Studio"
APP_ENV="production"
APP_DEBUG="false"
APP_URL="https://carnellistudio.com.uy"
APP_TIMEZONE="America/Montevideo"

# Seguridad y Anti-Spam
SECURITY_SALT="reemplazar_por_cadena_aleatoria_larga_en_produccion"
TURNSTILE_ENABLED="false"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Configuración SMTP (Hostinger)
SMTP_ENABLED="true"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_ENCRYPTION="ssl"
SMTP_USER="hola@carnellistudio.com.uy"
SMTP_PASS="tu_password_smtp_aqui"
SMTP_FROM_EMAIL="hola@carnellistudio.com.uy"
SMTP_FROM_NAME="Alex Carnelli · Carnelli Studio"

